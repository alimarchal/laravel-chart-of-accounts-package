flowchart TD
    S(["POST /journal-entries/{id}/post<br/>or auto_post: true"]) --> P0{"User has<br/>journal-entries.post?"}
    P0 -->|no| X0["403 Forbidden"]
    P0 -->|yes| L["Lock the entry row<br/>(SELECT … FOR UPDATE)"]
    L --> P1{"Status = draft?"}
    P1 -->|no| X1["422 Only draft journal<br/>entries can be posted"]
    P1 -->|yes| PA{"Needs approval?<br/>(approvals on, amount ≥ threshold<br/>in base currency, not yet approved)"}
    PA -->|yes| XA["422 Submit it for<br/>approval instead"]
    PA -->|no| P2{"At least 2 lines?"}
    P2 -->|no| X2["422 Needs two lines"]
    P2 -->|yes| P3{"Each line: debit XOR credit,<br/>amount > 0?"}
    P3 -->|no| X3["422 Each line must have<br/>either debit or credit"]
    P3 -->|yes| P4{"Every account active<br/>and not a group?"}
    P4 -->|no| X4["422 Only active<br/>posting accounts"]
    P4 -->|yes| P5{"Account currency =<br/>base or entry currency?"}
    P5 -->|no| X5["422 Currency mismatch"]
    P5 -->|yes| P6{"Σ debit = Σ credit<br/>(exact cents)?"}
    P6 -->|no| X6["422 Journal entry<br/>is not balanced"]
    P6 -->|yes| P7{"Open period covering<br/>the entry date?<br/>(shared lock: blocks a<br/>concurrent close only)"}
    P7 -->|no| X7["422 No open<br/>accounting period"]
    P7 -->|yes| P8{"Source document<br/>(e.g. BILL-778) not yet<br/>posted in this company?"}
    P8 -->|no| X8["422 Already posted as<br/>JV-2026-00012 —<br/>reverse that entry first"]
    P8 -->|yes| P9{"Control accounts only from<br/>their module (or user may<br/>post manually)? *"}
    P9 -->|no| X9["422 Post through the<br/>receivables / payables …<br/>module"]
    P9 -->|yes| BA["Freeze base-currency amounts<br/>(cents-exact, still balanced)"]
    BA --> DB{"Database:<br/>no line on a group account,<br/>document key unique?"}
    DB -->|no| XD["Rejected by the database<br/>(guards raw SQL and other apps)"]
    DB -->|yes| OK["status = posted<br/>posted_at, posted_by, period set"]
    OK --> AUD["Audit log: JOURNAL_POSTED<br/>+ DB trigger row snapshot"]
    AUD --> EV["JournalEntryPosted event<br/>(after commit → webhooks)"]
    EV --> DONE(["200 Posted entry<br/>now immutable"])

    classDef bad fill:#fee2e2,stroke:#b91c1c,color:#7f1d1d
    classDef good fill:#dcfce7,stroke:#15803d,color:#14532d
    classDef check fill:#fef3c7,stroke:#b45309,color:#78350f
    class X0,X1,XA,X2,X3,X4,X5,X6,X7,X8,X9,XD bad
    class BA,OK,AUD,EV,DONE good
    class P0,P1,PA,P2,P3,P4,P5,P6,P7,P8,P9,DB check
